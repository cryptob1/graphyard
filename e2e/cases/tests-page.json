{
  "id": "tests-page",
  "title": "The Tests page lists the test cases and their history",
  "description": "GET /api/tests answers every case with its window of recent runs, and the dashboard's Tests page renders after sign-in. A case linked by many items shows the count, the latest three and an 'and N more items' summary.",
  "tags": [
    "dashboard",
    "tests"
  ],
  "target": "uat",
  "required": true,
  "steps": [
    {
      "kind": "http",
      "name": "read the test summary",
      "method": "GET",
      "path": "/api/tests",
      "status": 200,
      "expect": [
        {
          "path": "window",
          "equals": 20
        },
        {
          "path": "cases",
          "type": "array"
        }
      ]
    },
    {
      "kind": "http",
      "name": "link item 1 to this case",
      "method": "POST",
      "path": "/api/work",
      "body": {
        "title": "E2E case {{case}} run {{run}} link 1",
        "description": "Created by the tests-page E2E case so its row has many linked items.",
        "type": "chore",
        "priority": 3,
        "criteria": [
          {
            "id": "AC-1",
            "text": "The Tests page folds a case's many linked items",
            "proofs": [
              "e2e:tests-page"
            ]
          }
        ],
        "policy": {
          "checks": [
            "test"
          ],
          "review": true
        }
      },
      "status": 200
    },
    {
      "kind": "http",
      "name": "link item 2 to this case",
      "method": "POST",
      "path": "/api/work",
      "body": {
        "title": "E2E case {{case}} run {{run}} link 2",
        "description": "Created by the tests-page E2E case so its row has many linked items.",
        "type": "chore",
        "priority": 3,
        "criteria": [
          {
            "id": "AC-1",
            "text": "The Tests page folds a case's many linked items",
            "proofs": [
              "e2e:tests-page"
            ]
          }
        ],
        "policy": {
          "checks": [
            "test"
          ],
          "review": true
        }
      },
      "status": 200
    },
    {
      "kind": "http",
      "name": "link item 3 to this case",
      "method": "POST",
      "path": "/api/work",
      "body": {
        "title": "E2E case {{case}} run {{run}} link 3",
        "description": "Created by the tests-page E2E case so its row has many linked items.",
        "type": "chore",
        "priority": 3,
        "criteria": [
          {
            "id": "AC-1",
            "text": "The Tests page folds a case's many linked items",
            "proofs": [
              "e2e:tests-page"
            ]
          }
        ],
        "policy": {
          "checks": [
            "test"
          ],
          "review": true
        }
      },
      "status": 200
    },
    {
      "kind": "http",
      "name": "link item 4 to this case",
      "method": "POST",
      "path": "/api/work",
      "body": {
        "title": "E2E case {{case}} run {{run}} link 4",
        "description": "Created by the tests-page E2E case so its row has many linked items.",
        "type": "chore",
        "priority": 3,
        "criteria": [
          {
            "id": "AC-1",
            "text": "The Tests page folds a case's many linked items",
            "proofs": [
              "e2e:tests-page"
            ]
          }
        ],
        "policy": {
          "checks": [
            "test"
          ],
          "review": true
        }
      },
      "status": 200
    },
    {
      "kind": "browser",
      "action": "open",
      "path": "/?sign-in"
    },
    {
      "kind": "browser",
      "action": "fill",
      "label": "Access token",
      "value": "{{token}}"
    },
    {
      "kind": "browser",
      "action": "click",
      "role": "button",
      "text": "Open control plane",
      "exact": false
    },
    {
      "kind": "browser",
      "action": "click",
      "role": "button",
      "text": "Tests"
    },
    {
      "kind": "browser",
      "action": "expectText",
      "role": "heading",
      "text": "Tests"
    },
    {
      "kind": "browser",
      "action": "expectText",
      "text": "its latest trusted result, and its history",
      "exact": false
    },
    {
      "kind": "browser",
      "name": "a case with many linked items folds the rest",
      "action": "expectText",
      "text": "more items",
      "exact": false
    }
  ]
}
