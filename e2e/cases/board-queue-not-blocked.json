{
  "id": "board-queue-not-blocked",
  "title": "The board shows heads waiting in the merge queue as moving, with their place and the merge ahead",
  "description": "Runs the real four-head batch executor and captures its board while its trial is pending, with two healthy heads and a recorded blocker waiting behind it.",
  "tags": [
    "api",
    "board",
    "dashboard"
  ],
  "target": "uat",
  "required": false,
  "steps": [
    {
      "kind": "command",
      "name": "run a batch to its pending trial with additional queued heads",
      "run": "node --import tsx scripts/e2e-seed-merge-queue.mjs",
      "timeoutSeconds": 60
    },
    {
      "kind": "http",
      "name": "the queued heads are moving with their queue position",
      "method": "GET",
      "path": "/api/board",
      "status": 200,
      "expect": [
        {
          "path": "groups.moving",
          "includes": {
            "key": "GY-QUEUED-1",
            "group": "moving",
            "overdue": false,
            "queue": {
              "position": 1,
              "ahead": "GY-QFLIGHT",
              "step": "tests"
            }
          }
        },
        {
          "path": "groups.moving",
          "includes": {
            "key": "GY-QUEUED-2",
            "group": "moving",
            "overdue": false,
            "queue": {
              "position": 2,
              "ahead": "GY-QFLIGHT"
            }
          }
        },
        {
          "path": "groups.blocked",
          "includes": {
            "key": "GY-QBLOCKED",
            "group": "blocked"
          }
        }
      ]
    },
    {
      "kind": "browser",
      "name": "open the local dashboard without signing in",
      "action": "open",
      "path": "/"
    },
    {
      "kind": "browser",
      "name": "the Work page names the queued head's place behind the merge in flight",
      "action": "expectText",
      "text": "behind GY-QFLIGHT (tests)",
      "exact": false
    }
  ]
}
