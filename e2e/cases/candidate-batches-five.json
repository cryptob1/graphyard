    {
      "kind": "http",
      "name": "the first change carries its merge commit",
      "method": "GET",
      "path": "/api/work/{{id1}}",
      "status": 200,
      "expect": [
        {
          "path": "mergeSha",
          "type": "string"
        }
      ],
      "save": {
        "mergeSha": "mergeSha"
      }
    },
    {
      "kind": "http",
      "name": "cut a candidate now",
      "method": "POST",
      "path": "/api/candidates",
      "body": {
        "trigger": "manual"
      },
      "status": 200,
      "expect": [
        {
          "path": "id",
          "type": "string"
        }
      ],
      "save": {
        "id": "candidateId"
      }
    },
    {
      "kind": "http",
      "name": "the candidate names exactly the five changes",
      "method": "GET",
      "path": "/api/candidates/{{candidateId}}",
      "status": 200,
      "expect": [
        {
          "path": "members.0.workId",
          "type": "string"
        },
        {
          "path": "members.4.workId",
          "type": "string"
        },
        {
          "path": "members.5.workId",
          "exists": false
        },
        {
          "path": "members",
          "includes": {
            "workId": "{{id1}}"
          }
        },
        {
          "path": "members",
          "includes": {
            "workId": "{{id2}}"
          }
        },
        {
          "path": "members",
          "includes": {
            "workId": "{{id3}}"
          }
        },
        {
          "path": "members",
          "includes": {
            "workId": "{{id4}}"
          }
        },
        {
          "path": "members",
          "includes": {
            "workId": "{{id5}}"
          }
        },
        {
          "path": "members",
          "includes": {
            "mergeSha": "{{mergeSha}}",
            "workId": "{{id1}}"
          }
        },
        {
          "path": "sourceSha",
          "type": "string"
        }
      ]
    },
    {
      "kind": "http",
      "name": "create a sixth change after the full batch",
      "method": "POST",
      "path": "/api/work",
      "body": {
        "criteria": [
          {
            "id": "AC-1",
            "proofs": [
              "e2e:fixture-static-home"
            ],
            "text": "The fixture site's home shows the sixth change"
