        "id": "id6"
      }
    },
    {
      "kind": "http",
      "name": "cut the next candidate",
      "method": "POST",
      "path": "/api/candidates",
      "body": {
        "trigger": "manual"
      },
      "status": 200,
      "expect": [
        {
          "path": "id",
          "type": "string"
        }
      ],
      "save": {
        "id": "candidateId2"
      }
    },
    {
      "kind": "http",
      "name": "the next candidate is the waiting change alone",
      "method": "GET",
      "path": "/api/candidates/{{candidateId2}}",
      "status": 200,
      "expect": [
        {
          "path": "members.0.workId",
          "equals": "{{id6}}"
        },
        {
          "path": "members.1.workId",
          "exists": false
        },
        {
          "path": "validation.result",
          "equals": "pass"
        }
      ]
    }
