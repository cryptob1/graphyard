{
  "id": "candidate-batches-five",
  "title": "Five ready changes form one exact candidate and the sixth waits",
  "description": "Five ready changes cut into one candidate that names exactly those five by work item, each bound to its merge commit under one exact source identity and never a sixth member; a change that arrives after the full batch waits and is the whole of the next candidate.",
  "tags": [
    "api",
    "delivery",
    "candidates"
  ],
  "target": "uat",
  "required": true,
  "secrets": [],
  "steps": [
    {
      "kind": "http",
      "name": "create ready change 1",
      "method": "POST",
      "path": "/api/work",
      "body": {
        "criteria": [
          {
            "id": "AC-1",
            "proofs": [
              "e2e:fixture-static-home"
            ],
            "text": "The fixture site's home shows change 1"
          }
        ],
        "policy": {
          "checks": [
            "test"
          ],
          "review": true
        },
        "priority": 3,
        "title": "E2E case {{case}} run {{run}} change 1",
        "type": "feature"
      },
      "status": 200,
      "expect": [],
      "save": {
        "id": "id1"
      }
    },
