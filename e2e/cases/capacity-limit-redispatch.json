{
  "id": "capacity-limit-redispatch",
  "title": "Mid-attempt provider limit exhaustion redispatches without losing work",
  "description": "Asserts the shipped capacity-limit-redispatch scenario revision is listed and runs the mid-attempt redispatch proofs (hold, failover, preserved work, truthful role bounds) without creating backlog items.",
  "tags": ["capacity"],
  "target": "any",
  "required": false,
  "steps": [
    {
      "kind": "http",
      "name": "shipped scenario revision is listed",
      "method": "GET",
      "path": "/api/scenarios",
      "status": 200,
      "expect": [
        {
          "path": "",
          "includes": {
            "id": "capacity-limit-redispatch",
            "revision": 1,
            "runner": "graphyard-e2e",
            "testPath": "e2e/cases/capacity-limit-redispatch.json"
          }
        }
      ]
    },
    {
      "kind": "command",
      "name": "mid-attempt capacity redispatch proofs",
      "run": "node --import tsx tests/helpers/run-tests.ts tests/capacity-redispatch-preserves-attempt.test.ts tests/capacity-hold-respects-machine-bounds.test.ts",
      "timeoutSeconds": 600
    }
  ]
}
