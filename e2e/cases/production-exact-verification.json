{
  "id": "production-exact-verification",
  "title": "Production is verified to run the promoted candidate exactly, and drift is caught",
  "description": "After a candidate is promoted, the delivery view shows the live production environment observed running exactly that release and source and verification 'verified'; when the fixture production app is redeployed with a different build, the next sweep turns verification to a mismatch while the expected release still names the promoted candidate.",
  "tags": [
    "api",
    "delivery",
    "production"
  ],
  "target": "uat",
  "required": true,
  "secrets": [],
  "steps": [
    {
      "kind": "http",
      "name": "create a change to release",
      "method": "POST",
      "path": "/api/work",
      "body": {
        "criteria": [
          {
            "id": "AC-1",
            "proofs": [
              "e2e:fixture-static-home"
            ],
            "text": "The fixture site's home shows this change"
          }
        ],
        "policy": {
          "checks": [
            "test"
          ],
          "review": true
        },
        "priority": 3,
        "title": "E2E case {{case}} run {{run}}",
        "type": "feature"
      },
      "status": 200,
      "expect": [],
      "save": {
        "id": "id"
      }
    },
    {
      "kind": "http",
      "name": "cut and promote its candidate",
      "method": "POST",
      "path": "/api/candidates",
      "body": {
        "trigger": "manual"
      },
      "status": 200,
      "expect": [
        {
          "path": "id",
          "type": "string"
        }
      ],
      "save": {
        "candidateId": "id"
      }
    },
    {
      "kind": "http",
      "name": "the candidate passed and promoted",
      "method": "GET",
      "path": "/api/candidates/{{candidateId}}",
      "status": 200,
      "expect": [
        {
          "path": "validation.result",
          "equals": "pass"
        },
        {
          "path": "promotion.releaseId",
          "type": "string"
        },
        {
          "path": "sourceSha",
          "type": "string"
        }
      ],
      "save": {
        "releaseId": "promotion.releaseId",
        "sourceSha": "sourceSha"
      }
    },
    {
      "kind": "http",
      "name": "the live environment runs exactly the promoted release, verified",
      "method": "GET",
      "path": "/api/delivery",
      "status": 200,
      "expect": [
        {
          "path": "environments.0.id",
          "equals": "production"
        },
        {
          "path": "environments.0.expected.releaseId",
          "equals": "{{releaseId}}"
        },
        {
          "path": "environments.0.expected.sourceSha",
          "equals": "{{sourceSha}}"
        },
        {
          "path": "environments.0.observed.releaseId",
          "equals": "{{releaseId}}"
        },
        {
          "path": "environments.0.observed.sourceSha",
          "equals": "{{sourceSha}}"
        },
        {
          "path": "environments.0.verification.status",
          "equals": "verified"
        }
      ]
    },
    {
      "kind": "http",
      "name": "redeploy the fixture production app with a different build",
      "method": "POST",
      "path": "/production/redeploy",
      "body": {
        "build": "drift-{{run}}"
      },
      "status": 200,
      "expect": []
    },
    {
      "kind": "http",
      "name": "sweep so verification re-reads the live environment",
      "method": "POST",
      "path": "/api/delivery/sweep",
      "status": 200,
      "expect": []
    },
    {
      "kind": "http",
      "name": "drift is caught while the expected release still names the candidate",
      "method": "GET",
      "path": "/api/delivery",
      "status": 200,
      "expect": [
        {
          "path": "environments.0.expected.releaseId",
          "equals": "{{releaseId}}"
        },
        {
          "path": "environments.0.expected.sourceSha",
          "equals": "{{sourceSha}}"
        },
        {
          "path": "environments.0.verification.status",
          "equals": "mismatched"
        },
        {
          "path": "environments.0.verification.reasons",
          "type": "array"
        }
      ]
    }
  ]
}
