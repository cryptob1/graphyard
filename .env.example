DATABASE_URL=postgres://graphyard:graphyard@localhost:5438/graphyard
PORT=4310
HOST=127.0.0.1
# Use distinct random secrets, at least 32 characters. Never share admin tokens with agents.
GRAPHYARD_PRINCIPALS=[{"id":"operator","role":"admin","token":"replace-with-a-long-random-admin-secret"},{"id":"master","role":"coordinator","token":"replace-with-a-long-random-coordinator-secret"},{"id":"agent-1","role":"worker","token":"replace-with-a-long-random-worker-secret"},{"id":"ci","role":"producer","proofs":["integration:claim-safety"],"token":"replace-with-a-long-random-ci-secret"}]
# One GitHub repository per control plane in v0.1.
GITHUB_REPOSITORY=your-org/your-repo
GITHUB_BASE_BRANCH=main
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
# IDs of apps allowed to supply CI checks (verify for your installation).
GITHUB_CI_APP_IDS=15368
