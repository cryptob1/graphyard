# The stable endpoint confined Graphyard sessions see in place of the session bus (see
# graphyard-secrets-bus.service). systemd holds this listening socket, so its inode outlives every
# restart of the proxies behind it: a session's bubblewrap namespace bind-mounts this inode, and a
# restarted proxy that recreated the socket would leave the session pinned to a dead listener.
# Install: copy the three graphyard-secrets-bus* units to ~/.config/systemd/user/, then
# `systemctl --user disable --now graphyard-secrets-bus.service` (an earlier install enabled the
# service itself) and `systemctl --user enable --now graphyard-secrets-bus.socket`.
[Unit]
Description=Graphyard keyring-only D-Bus endpoint for confined sessions
Before=graphyard-master.service

[Socket]
ListenStream=%t/graphyard-secrets-bus
SocketMode=0600

[Install]
WantedBy=sockets.target
