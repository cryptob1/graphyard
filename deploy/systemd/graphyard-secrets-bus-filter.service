# Keyring-only D-Bus proxy for confined Graphyard sessions (see docs/master-agent-sessions.md),
# reached through graphyard-secrets-bus.socket. A session without a GitHub credential of its own
# reaches org.freedesktop.secrets for what `gh auth git-credential` needs to read a login — open
# and close a session, unlock, search, read a secret, answer an unlock prompt — and nothing else:
# no item or collection is created, changed, locked or deleted, and every other bus name, systemd1
# included, stays unreachable, so `systemd-run --user` stays refused. Workers and reviewers carry
# their own short-lived credential and never get this bus (GY-999, GY-1039).
# What stays readable is every unlocked item, the operator's `gh` login included: xdg-dbus-proxy
# filters by method and object path, never by item attributes, and the master, approver and proof
# producer act with that login today. Narrowing them needs a per-session credential broker, a design
# of its own that GY-1039 leaves out of scope.
[Unit]
Description=Graphyard keyring-only D-Bus filter for confined sessions

[Service]
ExecStartPre=-/usr/bin/rm -f %t/graphyard-secrets-bus-filter
ExecStart=/usr/bin/xdg-dbus-proxy ${DBUS_SESSION_BUS_ADDRESS} %t/graphyard-secrets-bus-filter --filter \
  --call=org.freedesktop.secrets=org.freedesktop.Secret.Service.OpenSession@/org/freedesktop/secrets \
  --call=org.freedesktop.secrets=org.freedesktop.Secret.Service.Unlock@/org/freedesktop/secrets \
  --call=org.freedesktop.secrets=org.freedesktop.Secret.Service.SearchItems@/org/freedesktop/secrets \
  --call=org.freedesktop.secrets=org.freedesktop.Secret.Service.ReadAlias@/org/freedesktop/secrets \
  --call=org.freedesktop.secrets=org.freedesktop.DBus.Properties.Get@/org/freedesktop/secrets/* \
  --call=org.freedesktop.secrets=org.freedesktop.DBus.Properties.GetAll@/org/freedesktop/secrets/* \
  --call=org.freedesktop.secrets=org.freedesktop.Secret.Collection.SearchItems@/org/freedesktop/secrets/* \
  --call=org.freedesktop.secrets=org.freedesktop.Secret.Item.GetSecret@/org/freedesktop/secrets/* \
  --call=org.freedesktop.secrets=org.freedesktop.Secret.Session.Close@/org/freedesktop/secrets/session/* \
  --call=org.freedesktop.secrets=org.freedesktop.Secret.Prompt.Prompt@/org/freedesktop/secrets/prompt/* \
  --broadcast=org.freedesktop.secrets=org.freedesktop.Secret.Prompt.Completed@/org/freedesktop/secrets/prompt/*
Restart=always
RestartSec=2
