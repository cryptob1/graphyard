# Forwards each connection on the stable endpoint (graphyard-secrets-bus.socket) to the filtering
# proxy (graphyard-secrets-bus-filter.service). It connects per connection, so a session reconnects
# to a restarted filter through the same bind-mounted socket. Started by the socket; never enable
# it on its own.
[Unit]
Description=Graphyard keyring-only D-Bus forwarder for confined sessions
Requires=graphyard-secrets-bus.socket graphyard-secrets-bus-filter.service
After=graphyard-secrets-bus.socket graphyard-secrets-bus-filter.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd %t/graphyard-secrets-bus-filter
Restart=always
RestartSec=2
