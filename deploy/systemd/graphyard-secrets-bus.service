# Keyring-only D-Bus proxy for confined Graphyard sessions (see docs/master-agent-sessions.md).
# Sessions see this socket in place of the session bus: they reach org.freedesktop.secrets
# (the keyring behind `gh auth git-credential`) and nothing else, so `systemd-run --user`
# stays refused. Install: copy to ~/.config/systemd/user/ and
# `systemctl --user enable --now graphyard-secrets-bus`.
[Unit]
Description=Graphyard keyring-only D-Bus proxy for confined sessions
Before=graphyard-master.service

[Service]
ExecStartPre=-/usr/bin/rm -f %t/graphyard-secrets-bus
ExecStart=/usr/bin/xdg-dbus-proxy ${DBUS_SESSION_BUS_ADDRESS} %t/graphyard-secrets-bus --filter --talk=org.freedesktop.secrets
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
