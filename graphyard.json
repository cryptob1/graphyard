{
  "risk": {
    "sensitive": [
      {
        "rule": "persistence layer",
        "glob": "src/store/"
      },
      {
        "rule": "server auth, principals, API assembler, bootstrap or routes",
        "glob": "src/server/auth**"
      },
      {
        "rule": "server auth, principals, API assembler, bootstrap or routes",
        "glob": "src/server/principals**"
      },
      {
        "rule": "server auth, principals, API assembler, bootstrap or routes",
        "glob": "src/server/index**"
      },
      {
        "rule": "server auth, principals, API assembler, bootstrap or routes",
        "glob": "src/server/main**"
      },
      {
        "rule": "server auth, principals, API assembler, bootstrap or routes",
        "glob": "src/server/routes**"
      },
      {
        "rule": "operator agent",
        "glob": "src/operator-agent.ts"
      },
      {
        "rule": "installation",
        "glob": "src/install/"
      },
      {
        "rule": "deployment",
        "glob": "deploy/"
      },
      {
        "rule": "Dockerfile",
        "glob": "Dockerfile**"
      },
      {
        "rule": "compose file",
        "glob": "compose.yaml"
      },
      {
        "rule": "CI configuration",
        "glob": ".github/"
      },
      {
        "rule": "dependencies",
        "glob": "package.json"
      },
      {
        "rule": "dependencies",
        "glob": "package-lock.json"
      },
      {
        "rule": "merge path",
        "glob": "src/merger-mode.ts"
      },
      {
        "rule": "merge path",
        "glob": "src/regression-guard.ts"
      },
      {
        "rule": "merge writer",
        "glob": "src/merge-writer/"
      }
    ]
  },
  "e2e": {
    "pendingOutcomes": "non-blocking",
    "serve": {
      "command": "node --import tsx scripts/e2e-serve.mjs",
      "url": "http://127.0.0.1:4391/healthz?ready",
      "readySeconds": 120
    }
  },
  "product": {
    "ui": [
      "web/"
    ]
  },
  "delivery": {
    "mode": "local",
    "mergeGate": {
      "preMerge": [
        {
          "check": "browser-tests/",
          "command": "npm run test:browser",
          "source": "script",
          "reason": "Dashboard changes run the browser suite",
          "paths": [
            "web/",
            "browser-tests/",
            "src/server/routes/",
            "src/server/routes.ts",
            "src/model/board.ts",
            "scripts/dashboard-fixture.mjs",
            "playwright.config.ts",
            "vite.config.ts"
          ]
        },
        {
          "check": "test",
          "command": "node --import tsx tests/helpers/run-tests.ts",
          "source": "script",
          "reason": "Run affected pre-merge tests in bounded shards",
          "selection": {
            "command": "node scripts/ci-tests.mjs affected",
            "pattern": "^tests/[\\w./-]+\\.test\\.ts$",
            "durations": "tests/helpers/timing-baseline.json"
          }
        }
      ],
      "perCandidate": []
    },
    "candidateSchedule": null,
    "deploy": {
      "adapter": "command",
      "project": null,
      "uat": null,
      "production": null
    }
  }
}
